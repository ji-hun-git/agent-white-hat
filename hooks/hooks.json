{
  "description": "agent-white-hat guard: judges commands, file writes, credential reads, fetches and MCP calls before they run, and each step against the steps before it in the session; checks what tools return for instructions aimed at the agent; scans new clones; and checks the project and agent configuration at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pah-hook\" pre",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|WebFetch|WebSearch|Grep|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pah-hook\" post",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pah-hook\" session-start",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
